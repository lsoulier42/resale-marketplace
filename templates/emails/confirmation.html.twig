<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Confirmez votre compte Resale Marketplace</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f6f2fb; font-family: -apple-system, 'Segoe UI', Roboto, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f6f2fb; padding: 32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 480px; background-color: #ffffff; border-radius: 16px; box-shadow: 0 8px 24px rgba(139, 92, 246, 0.15);">
                    <tr>
                        <td style="padding: 32px;">
                            <h1 style="margin: 0 0 16px; font-size: 22px; color: #6d28d9;">Bienvenue sur Resale Marketplace&nbsp;!</h1>
                            <p style="margin: 0 0 12px; color: #4b5563; line-height: 1.6;">Bonjour,</p>
                            <p style="margin: 0 0 20px; color: #4b5563; line-height: 1.6;">
                                Pour activer votre compte et accéder à la boutique, confirmez votre adresse email
                                en cliquant sur le lien ci-dessous&nbsp;:
                            </p>
                            <p style="margin: 0 0 20px; text-align: center;">
                                <a href="{{ confirmationUrl }}"
                                   style="display: inline-block; padding: 12px 24px; background-color: #8b5cf6; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600;">
                                    Confirmer mon adresse email
                                </a>
                            </p>
                            <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px; line-height: 1.5;">
                                Ce lien est valable 24&nbsp;heures. Si le bouton ne fonctionne pas, copiez cette adresse
                                dans votre navigateur&nbsp;:
                            </p>
                            <p style="margin: 0 0 16px; color: #8b5cf6; font-size: 12px; word-break: break-all;">
                                {{ confirmationUrl }}
                            </p>
                            <p style="margin: 0; color: #9ca3af; font-size: 12px; line-height: 1.5;">
                                Si vous n'êtes pas à l'origine de cette inscription, ignorez simplement cet email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
