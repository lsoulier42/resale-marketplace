# Copier ce fichier vers .env, puis ajuster les valeurs si besoin.
# Les valeurs ci-dessous sont les défauts de développement : la stack
# démarre sans modification (cp .env.example .env && make install).
APP_ENV=dev
APP_SECRET=change-me
APP_VERSION=dev
APP_PORT=8081

DATABASE_USER=app
DATABASE_PORT=5432
DATABASE_HOST=database
DATABASE_NAME=resale_marketplace
DATABASE_PASSWORD=app
DATABASE_URL=postgresql://app:app@database:5432/resale_marketplace?serverVersion=18.2&charset=utf8

# Port hôte exposé par Docker pour PostgreSQL (défaut : 5532)
DATABASE_HOST_PORT=5532
# Ports hôte exposés par Docker pour Mailpit (défauts : 1126 / 1181)
MAILER_SMTP_PORT=1126
MAILER_HTTP_PORT=1181

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

MAILER_DSN=smtp://mailer:1025

# Base URL publique de la SPA (utilisée dans les emails de confirmation et les URLs Stripe)
APP_BASE_URL=http://localhost:8081
# Expéditeur des emails transactionnels
MAILER_FROM=noreply@example.test

# Stripe Connect — clés du compte plateforme (test/prod).
# Laisser vide pour désactiver le paiement (développement / tests).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Commission de la plateforme en % (défaut : 5)
PLATFORM_FEE_PERCENT=5

APP_SHARE_DIR=/var/www/html/var
